# Recipe of the image tagged `audit3-stable186` on the x86_64 machine (image ID
# sha256:c62c2fe8fb9a745cf0824c2987b5696ee6bacd1994abe9fa3aaa34266b1d0112, amd64, built 2026-11-05).
# It ran the FLOURINE mutation analyses (pipeline.json flourine.mutation phase m,
# flourine.arxiv_mutation_ubfilter phase m, flourine.arxiv_mutation_ubfilter_fuzzprofile).
#
# How it was built: `docker build -t audit3-stable186 -f docker/Dockerfile.stable docker/` from a copy of
# this repository whose docker/Dockerfile.stable was the version of the development repository's
# commit ec470ae (file sha256 0be71194c01f12d83c31bf20cbcc8149e90961b4a3edf18ae8f9a315ec7b1c8f).
# The instructions below are that file's, byte for byte, except FROM: the original read the tag `ubuntu:22.04`, which on that machine
# resolved to the digest pinned here (its single base layer, sha256:129f77d8..., is the image's first
# layer). `docker history audit3-stable186` lists exactly these steps.
#
# Not pinned in the original recipe: apt installed from the live Ubuntu archive on 2026-11-05 and rustup
# came from sh.rustup.rs (rustup 1.29.3 in the image) with toolchain 1.86.0, so a rebuild today gets newer
# Ubuntu package revisions; docker/manifests/audit3-stable186.amd64.dpkg.txt lists the packages of the image
# the results came from (gcc 11.4.0-1ubuntu1~22.04.3, Python 3.10.12, rustc 1.86.0). docker/Dockerfile.stable
# is the same recipe with apt pinned to a snapshot and rustup pinned by version and sha256; it gives the
# same compilers (gcc 11.4, rustc 1.86.0).
#
#   docker build -t audit3-stable186 -f docker/Dockerfile.audit3-stable186 docker/
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc make curl ca-certificates git python3 libc6-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --default-toolchain 1.86.0 --profile minimal \
    && rustc --version && cargo --version && gcc --version | head -1

WORKDIR /work
CMD ["bash"]
